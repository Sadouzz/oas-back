# Profil Spring actif : dev pour un poste local, prod pour le déploiement.
SPRING_ACTIVE_PROFILE=dev
PORT=9090

# PostgreSQL. DATABASE_USERNAME est le nom standard utilisé par dev et prod.
# DATABASE_HOSTNAME reste accepté en dev uniquement pour compatibilité ancienne.
DATABASE_URL=jdbc:postgresql://localhost:5432/facturation
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME

# Clé de signature JWT : générer une valeur aléatoire forte et la garder secrète.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Envoi de courriels (exemple Gmail : utiliser un mot de passe d'application).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=CHANGE_ME

# Stockage des médias Cloudinary.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Origines autorisées par le backend, séparées par des virgules.
CORS_ORIGINS=http://localhost:4200

# Cookies d'authentification. En production HTTPS, garder Secure=true et SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Notifications Push Web : facultatif si les notifications push ne sont pas configurées.
OAS_PUSH_VAPID_PUBLIC_KEY=
OAS_PUSH_VAPID_PRIVATE_KEY=
OAS_PUSH_VAPID_SUBJECT=mailto:admin@orientautoservice.sn

# Le frontend Angular ne lit pas ce fichier : son URL API est définie dans
# oas-front/src/environments/environment.ts et environment.prod.ts.
