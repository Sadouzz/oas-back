# OAS BACKEND — copier ce fichier vers .env, puis remplacer tous les REPLACE_ME.
# Le backend charge .env depuis le dossier oas-back au démarrage.

# Profil Spring : dev en local, prod pour un déploiement.
SPRING_PROFILES_ACTIVE=dev
PORT=9090

# PostgreSQL — paramètres obligatoires dans les profils dev et prod.
DATABASE_URL=jdbc:postgresql://localhost:5432/facturation
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=REPLACE_ME
# DATABASE_HOSTNAME est encore accepté comme ancien alias de DATABASE_USERNAME.

# Authentification — JWT_SECRET doit contenir au moins 32 caractères aléatoires.
# Génération conseillée : openssl rand -hex 32
JWT_SECRET=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_-hex_32

# Signature enregistrée par les agents — clé Base64 de 32 octets, requise pour enregistrer/lire les signatures.
# Génération : openssl rand -base64 32
# La garder stable et identique sur toutes les instances qui partagent la base de données.
AGENT_SIGNATURE_ENCRYPTION_KEY=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_-base64_32

# Courriel SMTP — requis pour l'envoi des fiches atelier, factures et notifications par email.
# Pour Gmail, utiliser un mot de passe d'application.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_ME_WITH_SMTP_PASSWORD

# Cloudinary — requis pour l'envoi et le stockage des médias.
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Origines web autorisées par CORS, séparées par des virgules sans espaces.
# En local, garder l'origine du frontend Angular. En production, remplacer par le ou les domaines déployés.
CORS_ORIGINS=http://localhost:4200

# Cookies d'authentification. En production HTTPS : true et SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Notifications Web Push — facultatives. Renseigner les deux clés VAPID pour les activer.
# OAS_PUSH_VAPID_PUBLIC_KEY=REPLACE_ME
# OAS_PUSH_VAPID_PRIVATE_KEY=REPLACE_ME
OAS_PUSH_VAPID_PUBLIC_KEY=
OAS_PUSH_VAPID_PRIVATE_KEY=
OAS_PUSH_VAPID_SUBJECT=mailto:admin@orientautoservice.sn

# Ancien nom de SPRING_PROFILES_ACTIVE, encore reconnu par application.yml :
# SPRING_ACTIVE_PROFILE=dev
